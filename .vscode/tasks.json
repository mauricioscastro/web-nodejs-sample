{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "binaryInputValue",
      "type": "promptString",
      "description": "Personal Access Token:",
      "default": "default-value"
    }
  ],  
  "tasks": [
    
    {
      "label": "Run Interactive Startup Binary",
      "type": "shell",
      "command": "$HOME/gh-login.sh ${input:binaryInputValue}",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}